* text=auto
# Hook scripts run in bash; CRLF breaks them on Windows clones.
*.sh text eol=lf
*.pdf binary
*.png binary
*.jpg binary
# The demo home's files are pinned by integrity hashes; a line-ending change would break them.
apps/home/** text eol=lf
apps/home/img/** binary
*.webp binary
*.svg text eol=lf
apps/home/media/** binary
*.mp4 binary
# Lock files are generated: collapsed in PR diffs.
uv.lock linguist-generated=true
.terraform.lock.hcl linguist-generated=true
**/package-lock.json linguist-generated=true
# The knowledge base's files are hashed for ingestion; a line-ending change would re-ingest them.
data/knowledge/** text eol=lf
*.gif binary
