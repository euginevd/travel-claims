{
  "name": "undercover-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . node_modules/@undercover/web-core/src && prettier --check . && prettier --check --with-node-modules node_modules/@undercover/web-core/src",
    "format": "prettier --write . && prettier --write --with-node-modules node_modules/@undercover/web-core/src",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@undercover/web-core": "file:../../packages/web-core",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
