# Copy to .env and fill in. Never commit .env.

# --- Claude ---
# The Console workspace this app bills to (Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# --- PostgreSQL (local Docker only) ---
POSTGRES_USER=undercover
POSTGRES_PASSWORD=
POSTGRES_DB=undercover

# --- App ---
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
UNDERCOVER_API_KEY=
HANDLER_PASSWORD=
LOCAL_SIGN_IN=true
ENVIRONMENT=local

# Only when running the api without Docker (Compose sets it for you):
# DATABASE_URL=sqlite:///local/undercover.db

# Tier 2, for scripts/github-setup.sh (guides/02-aws-runbook.md, step 4). The bootstrap stack's outputs,
# when the AWS CLI isn't signed in:
TF_STATE_BUCKET=
AWS_PLAN_ROLE_ARN=
AWS_DEPLOY_ROLE_ARN=
# Optional: alert email, monthly budget in USD (default 10), false where CloudFront's Free plan isn't allowed,
# and true where a platform team already runs the account-wide budget and Access Analyzer
# (decision 35), so the platform unit is skipped.
ALERT_EMAIL=
MONTHLY_BUDGET=
CLOUDFRONT_FREE_PLAN=
PLATFORM_MANAGED=
