# Copy to .env and fill in. Never commit .env.

# --- Claude ---
# The Console workspace this app bills to (Settings -> Workspaces).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# --- PostgreSQL (local Docker only) ---
POSTGRES_USER=undercover
POSTGRES_PASSWORD=
POSTGRES_DB=undercover

# --- App ---
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
UNDERCOVER_API_KEY=
HANDLER_PASSWORD=
LOCAL_SIGN_IN=true
ENVIRONMENT=local

# Only when running the api without Docker (Compose sets it for you):
# DATABASE_URL=sqlite:///local/undercover.db

# AWS, for scripts/github-setup.sh (guides/02-aws-runbook.md, step 4). The bootstrap stack's outputs,
# when the AWS CLI isn't signed in:
TF_STATE_BUCKET=
AWS_PLAN_ROLE_ARN=
AWS_DEPLOY_ROLE_ARN=
# Optional: where alarms are emailed, on for the platform's Firewall Manager WAF on the sites (default off),
# private for the
# platform team's private network (default public, no VPC), and the percentage of live agent sessions
# scored online (default 0, off). The platform team's own pieces are assumed (decision 41).
ALERT_EMAIL=
# How receipts are read on AWS: textract (default, Sydney only) or none; data-automation needs an
# asynchronous project first (decision 50).
RECEIPT_READER=
CLOUDFRONT_WAF=
NETWORK_MODE=
EVALUATION_SAMPLING=
# Optional, off unless set (decision 39): true puts the api and Copilot behind API Gateway. Reference
# only, never set here (decisions 41 and 44): the company's Okta SAML app for staff, and the
# dashboard's and console's addresses, comma-separated.
API_GATEWAY=
STAFF_SAML_METADATA_URL=
STAFF_SIGN_IN_URLS=
# Optional, off unless set (decision 45): platform for the platform team's KMS data key, the company's
# domain for the sites (its Route 53 zone delegated here), true to scan receipts for malware, and true to
# mask personal data in the functions' logs, and true for the api's own database role.
ENCRYPTION_KEYS=
DOMAIN_NAME=
MALWARE_SCANNING=
LOG_MASKING=
DATABASE_APP_ROLE=
